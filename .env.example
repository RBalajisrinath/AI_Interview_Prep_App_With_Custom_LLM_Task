# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/interview-prep

# JWT
JWT_SECRET=task_11225578_2026
JWT_EXPIRES_IN=7d

# LLM (Ollama runs locally; no API key or payment required)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
LLM_TIMEOUT_MS=60000

# CORS
CORS_ORIGIN=http://localhost:3000

# Crawler
MAX_PAGES_PER_CRAWL=15
CRAWL_TIMEOUT_MS=10000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
